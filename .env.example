# --- Supabase -------------------------------------------------------------
# El proyecto es "misterprecios.com@gmail.com's Project" (ref ffflzszdhbqnjumkkhul).
# Cada dueño corre las migraciones de supabase/migrations/ en SU propio proyecto
# y cambia estas dos líneas; no se reutiliza la base de nadie más.
NEXT_PUBLIC_SUPABASE_URL=https://ffflzszdhbqnjumkkhul.supabase.co
# Publishable key: es pública por diseño, va al navegador. Con RLS sin policies
# no da acceso a ninguna tabla; hoy solo la usa Supabase Auth (panel, paso 4).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# SECRETA. Bypassea RLS. Solo en el servidor, jamás con prefijo NEXT_PUBLIC_.
# Dashboard > Project Settings > API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Acceso al panel ------------------------------------------------------
# Correos habilitados para entrar a /panel, separados por coma. SIN ESTO NO
# ENTRA NADIE: es a propósito, falla cerrado.
#
# Tener sesión de Supabase Auth NO alcanza para entrar. Un proyecto de Supabase
# trae el alta pública de usuarios habilitada por defecto y la publishable key
# va en el JavaScript del sitio, así que sin esta lista cualquiera podría
# registrarse solo y quedar adentro del panel, que lee con service_role.
# Además de esto, hay que dejar el alta pública DESHABILITADA en el dashboard:
# Authentication > Providers > Email > "Allow new users to sign up".
PANEL_EMAILS_AUTORIZADOS=vos@tudominio.com

# --- Gemini ---------------------------------------------------------------
# Normalización del producto y (paso 6) extracción de cotizaciones.
# El modelo está fijo en src/lib/ia.ts (hoy gemini-3.7-flash). Si la llave es de
# una cuenta nueva, verificá que ese modelo le responda: los retirados siguen
# saliendo en ListModels pero devuelven 404 al llamarlos.
# La llave se saca en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Correo (Resend) ------------------------------------------------------
RESEND_API_KEY=
# Debe estar en un dominio verificado en Resend. Para probar sin dominio usá
# onboarding@resend.dev; en ese modo Resend SOLO entrega al dueño de la cuenta.
MAIL_FROM=Mister Precios <onboarding@resend.dev>

# Dirección a la que van las respuestas de los vendedores. OBLIGATORIA si el
# dominio de MAIL_FROM no recibe correo: verificar un dominio en Resend habilita
# enviar, nunca recibir, y las plantillas piden "respondé este correo". Sin esto
# cada respuesta rebota y el flujo se corta donde llega la cotización.
# Dejar vacía solo si la casilla de MAIL_FROM ya recibe.
MAIL_REPLY_TO=
# Copia interna de control en cada correo al vendedor. El cliente va SIEMPRE en
# copia de ese correo, sin importar esta variable; esto agrega una dirección más.
MAIL_CC_INTERNO=

# --- App ------------------------------------------------------------------
# Base para los enlaces absolutos de los correos, incluidos los botones de
# cierre del correo de 72h. En Vercel, la URL del deploy.
# Si queda mal, los botones de ese correo no abren.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Crons ----------------------------------------------------------------
# Protege /api/cron/alertas. Vercel manda esta variable como
# `Authorization: Bearer $CRON_SECRET` en cada corrida programada.
# Sin ella el endpoint responde 401 y las alertas NO salen.
# Generar con: openssl rand -hex 32
CRON_SECRET=
