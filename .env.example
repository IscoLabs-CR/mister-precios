# --- Supabase -------------------------------------------------------------
# El proyecto es "mr-precios" (ref fipiavbvjmawzayvqroi).
NEXT_PUBLIC_SUPABASE_URL=https://fipiavbvjmawzayvqroi.supabase.co
# Publishable key: es pública por diseño, va al navegador. Con RLS sin policies
# no da acceso a ninguna tabla; hoy solo la usa Supabase Auth (panel, paso 4).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# SECRETA. Bypassea RLS. Solo en el servidor, jamás con prefijo NEXT_PUBLIC_.
# Dashboard > Project Settings > API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini ---------------------------------------------------------------
# Normalización del producto y (paso 6) extracción de cotizaciones.
# gemini-2.5-flash. Se saca en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Correo (Resend) ------------------------------------------------------
RESEND_API_KEY=
# Debe estar en un dominio verificado en Resend. Para probar sin dominio usá
# onboarding@resend.dev; en ese modo Resend SOLO entrega al dueño de la cuenta.
MAIL_FROM=Mister Precios <onboarding@resend.dev>
# Copia interna de control en cada correo al vendedor. El cliente va SIEMPRE en
# copia de ese correo, sin importar esta variable; esto agrega una dirección más.
MAIL_CC_INTERNO=

# --- App ------------------------------------------------------------------
# Base para los enlaces absolutos de los correos, incluidos los botones de
# cierre del correo de 72h. En Vercel, la URL del deploy.
# Si queda mal, los botones de ese correo no abren.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Crons ----------------------------------------------------------------
# Protege /api/cron/alertas. Vercel manda esta variable como
# `Authorization: Bearer $CRON_SECRET` en cada corrida programada.
# Sin ella el endpoint responde 401 y las alertas NO salen.
# Generar con: openssl rand -hex 32
CRON_SECRET=
